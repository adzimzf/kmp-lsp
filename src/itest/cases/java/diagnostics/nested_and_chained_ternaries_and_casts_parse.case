package com.demo;

class Ma$0in {
    int sign(int value) {
        return value > 0 ? 1 : value < 0 ? -1 : 0;
    }

    long widen(Object value) {
        return (long) (int) (Integer) value + ~(byte) 1 + -(short) 2;
    }

    boolean bits(int flags) {
        return (flags & 0x1) != 0 ^ (flags >>> 2 | flags << 1 >> 1) == 0;
    }
}
