//- /com/demo/Lambdas.java
package com.demo;

import java.util.concurrent.CompletableFuture;

class Lam$0bdas {
    void chain(CompletableFuture<String> future) {
        future.thenApply(text -> {
            return text.trim();
        }).thenAccept(text -> {
            System.out.println(text);
        });
    }

    void twoArguments() {
        run(() -> {
            System.out.println("first");
        }, () -> {
            System.out.println("second");
        });
    }

    void anonymousThenLambda() {
        run(new Runnable() {
            public void run() {
                System.out.println("anonymous");
            }
        }, () -> {
            System.out.println("lambda");
        });
    }

    void streams(java.util.List<String> words) {
        words.stream()
                .filter(word -> {
                    return !word.isEmpty();
                })
                .forEach(word -> {
                    System.out.println(word);
                });
    }

    void run(Runnable first, Runnable second) {
        first.run();
        second.run();
    }
}
