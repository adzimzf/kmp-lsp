package com.demo;

enum Unit {
    MET$0RE,
    FOOT
}
//- /com/demo/Main.java
package com.demo;

class Main {
    Unit unit = Unit.METRE;

    double scale(Unit unit) {
        switch (unit) {
            case METRE:
                return 1.0;
            case FOOT:
                return 0.3048;
            default:
                return 0.0;
        }
    }
}
