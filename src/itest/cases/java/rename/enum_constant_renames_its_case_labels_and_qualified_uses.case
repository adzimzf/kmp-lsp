package com.demo;

enum Color {
    RED,
    GREEN
}
//- /com/demo/Main.java
package com.demo;

class Main {
    Color color = Color.GREEN;

    boolean go(Color current) {
        return switch (current) {
            case GR$0EEN -> true;
            case RED -> false;
        };
    }
}
