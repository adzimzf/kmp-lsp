package com.demo

inline fun each(items: List<Int>, action: (Int) -> Unit) {
    for (item in items) action(item)
}

fun sumUn$0tilZero(items: List<Int>): Int {
    var sum = 0
    for (round in 0 until 1) {
        each(items) { item ->
            if (item == 0) break
            sum += item
        }
    }
    return sum
}
